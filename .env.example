# ==============================================================================
# DABERUSA - Sistema de Cobranza y Control de Riesgo de Venta
# Copia este archivo como .env y completa tus credenciales antes de desplegar
# ==============================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=daberusa_cobranza
POSTGRES_USER=daberusa
POSTGRES_PASSWORD=daberusa_secure_password_change_me
POSTGRES_PORT=5432

# --- Backend FastAPI ---
BACKEND_PORT=8000
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
RISK_REMINDER_THRESHOLD=3
AUTO_SEED_DEMO_USERS=true
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost

# --- Token interno compartido entre Backend y Contenedor Scraper ---
SCRAPER_INTERNAL_TOKEN=change-this-internal-scraper-token

# --- Correo SMTP (Gmail, Microsoft 365 o servidor corporativo propio) ---
# Nota: Si SMTP_DRY_RUN=true o SMTP_HOST queda vacío, los recordatorios se registran
# en modo simulación (DRY_RUN) sin enviar correos reales, ideal para pruebas iniciales.
SMTP_DRY_RUN=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=cobranza@daberusa.cl
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=cobranza@daberusa.cl
SMTP_FROM_NAME=Cobranza DABERUSA
COMPANY_NAME=DABERUSA

# --- Contenedor Scraper (facturacion.cl) ---
SCRAPER_PORT=8001
# Modos disponibles: "mock" (datos chilenos de prueba) o "playwright" (scraping real)
SCRAPER_MODE=mock
# Cron formato 5 campos (min hora dia mes dia_semana) en hora Chile (America/Santiago)
# Por defecto: lunes a viernes a las 08:30 y 14:30
SCRAPE_SCHEDULE_CRON=30 8,14 * * 1-5
SCRAPE_TIMEZONE=America/Santiago
SCRAPER_RUN_ON_STARTUP=true

# Credenciales y configuración real de facturacion.cl (usado cuando SCRAPER_MODE=playwright)
FACTURACION_BASE_URL=https://www.facturacion.cl
FACTURACION_SYSTEM_SLUG=daberusa
FACTURACION_USERNAME=
FACTURACION_PASSWORD=
FACTURACION_HEADLESS=true
FACTURACION_TIMEOUT_MS=30000

# --- Frontend Angular (Nginx) ---
FRONTEND_PORT=8080
